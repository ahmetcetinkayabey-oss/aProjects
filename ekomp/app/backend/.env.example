PORT=3001
CORS_ORIGIN=http://localhost:3000

# NODE_ENV=production anahtarıyla PostgreSQL'e geçilir; aksi halde (development)
# otomatik olarak SQLite kullanılır ve aşağıdaki DB_* ayarları yok sayılır.
NODE_ENV=development

# Development (SQLite) — opsiyonel, dosya yolu
DB_SQLITE_PATH=data/dev.sqlite

# Production (PostgreSQL) — yalnızca NODE_ENV=production iken kullanılır
# Supabase > Connect > Session pooler (IPv4). Şifredeki özel karakterleri URL-encode edin.
DATABASE_URL=postgresql://postgres.<ref>:<SIFRE>@aws-0-<bolge>.pooler.supabase.com:5432/postgres
# Boş veritabanında ilk deploy'da tabloları oluşturmak için geçici olarak true yapın
# DB_SYNCHRONIZE=false
# CORS_ORIGIN virgülle birden fazla adres alabilir; CORS_ORIGIN_REGEX preview domainleri içindir
# CORS_ORIGIN_REGEX=^https://proje-.*\.vercel\.app$

# Görsel depolama (yayında ZORUNLU): Supabase > Storage'da herkese açık (public) bir "uploads" kovası açın.
# Değerler boşsa görseller yerel uploads/ klasörüne yazılır (yalnızca geliştirme; Render'da deploy'da silinir).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=   # Project Settings > API > service_role (GİZLİ tutun, frontend'e koymayın)
# SUPABASE_BUCKET=uploads

# Admin paneli (ilk açılışta yönetici hesabı bu bilgilerle oluşturulur; sonra panelden şifreyi değiştirin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# En az 32 karakterlik rastgele bir değer. Production'da mutlaka benzersiz olmalı.
ADMIN_TOKEN_SECRET=

# Forum 2027: e-posta doğrulama / şifre sıfırlama bağlantılarının kök adresi (frontend)
FORUM_PUBLIC_URL=http://localhost:3000

# E-posta (SMTP): forum doğrulama/şifre sıfırlama e-postaları için GEREKLİ; yeni kamp talebi bildirimi için NOTIFY_TO da verin (isteğe bağlı)
# Ücretsiz seçenek: Brevo (günde 300 e-posta) → SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=Brevo giriş e-postası, SMTP_PASS=Brevo SMTP anahtarı.
# NOTIFY_FROM, Brevo'da doğruladığınız gönderen adres olmalı.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=

# Proxy arkasında çalışıyorsa (Vercel, Nginx, Render vb.) 1 verin; hız sınırı gerçek IP'yi görsün
# TRUST_PROXY=1
